<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/Config/Log/internal-nlog.txt">

	<!-- CustomConsole日志布局 -->
	<variable name="info" value="${newline}日志时间：	${date}
            ${newline}日志内容：
            ${newline}+----------------------+
            ${newline}| ${message} |
            ${newline}+----------------------+
            ${newline}-----------------------------------------------------------" />

	<!-- 每个NlogLoggerType枚举值一个target，日志按天写入对应文件夹 -->
	<targets>
		<target xsi:type="File" name="Info" fileName="${basedir}/Logs/Info/${shortdate}.txt" layout="${info}" />
		<target xsi:type="File" name="Login" fileName="${basedir}/Logs/Login/${shortdate}.txt" layout="${info}" />
		<target xsi:type="File" name="Error" fileName="${basedir}/Logs/Error/${shortdate}.txt" layout="${info}" />
		<target xsi:type="File" name="Quartz" fileName="${basedir}/Logs/Quartz/${shortdate}.txt" layout="${info}" />
		<target xsi:type="File" name="SignalR" fileName="${basedir}/Logs/SignalR/${shortdate}.txt" layout="${info}" />
		<target xsi:type="File" name="Job" fileName="${basedir}/Logs/Job/${shortdate}.txt" layout="${info}" />
	</targets>

	<rules>
		<!-- 屏蔽Microsoft框架日志 -->
		<logger name="Microsoft.*" minlevel="Trace" final="true" />
		<logger name="Info" minlevel="Trace" writeTo="Info" />
		<logger name="Login" minlevel="Trace" writeTo="Login" />
		<logger name="Error" minlevel="Trace" writeTo="Error" />
		<logger name="Quartz" minlevel="Trace" writeTo="Quartz" />
		<logger name="SignalR" minlevel="Trace" writeTo="SignalR" />
		<logger name="Job" minlevel="Trace" writeTo="Job" />
	</rules>
</nlog>
